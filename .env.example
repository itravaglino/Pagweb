# Servidor
PORT=3000
PUBLIC_URL=http://localhost:3000

# NVIDIA NIM (gratis en https://build.nvidia.com — Get API Key)
# También se puede pegar la clave en Ajustes de la web.
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# Fitbit (https://dev.fitbit.com/apps — tipo Client, redirect:
#   {PUBLIC_URL}/api/fitbit/callback
# scopes: activity heartrate sleep profile)
FITBIT_CLIENT_ID=
FITBIT_CLIENT_SECRET=
FITBIT_REDIRECT_URI=

# Base persistente (tests). Si está vacío, escribe en
# /cursor/stores/self/pagweb/db.json y en data/pagweb.json
PAGWEB_DB_PATH=
